#!/bin/sh
# SPDX-FileCopyrightText: Kevin Stenzel
# SPDX-License-Identifier: GPL-3.0-or-later
set -e

# System user (in the docker group for socket access)
if ! getent passwd lmnradius >/dev/null 2>&1; then
    adduser --system --group --no-create-home \
        --home /var/lib/linuxmuster-radius lmnradius
fi
if getent group docker >/dev/null 2>&1; then
    usermod -aG docker lmnradius || true
fi

# Config + secrets + EAP certs live under /etc; instances (git log) + rendered
# instance.d configs live under /var/lib. Keys below MUST match lmnradius.config.Settings.
mkdir -p /etc/linuxmuster-radius/secrets /etc/linuxmuster-radius/certs \
         /var/lib/linuxmuster-radius/instances /var/lib/linuxmuster-radius/instance.d

# Config with a random API token (only if it does not exist yet)
CFG=/etc/linuxmuster-radius/config.yml
if [ ! -f "$CFG" ]; then
    TOKEN="$(openssl rand -hex 32)"
    # umask 077 -> file is created with 0600 (no 0644 window for the API token).
    ( umask 077
      cat > "$CFG" <<EOF
api_token: "$TOKEN"
instances_dir: /var/lib/linuxmuster-radius/instances
secrets_dir: /etc/linuxmuster-radius/secrets
certs_dir: /etc/linuxmuster-radius/certs
render_dir: /var/lib/linuxmuster-radius/instance.d
bind_host: 127.0.0.1
bind_port: 8080
api_url: http://127.0.0.1:8080
EOF
    )
    chmod 600 "$CFG"
fi

chown -R lmnradius:lmnradius /etc/linuxmuster-radius /var/lib/linuxmuster-radius
# secrets holds per-client shared secrets; certs holds EAP CA + server keys.
chmod 700 /etc/linuxmuster-radius/secrets /etc/linuxmuster-radius/certs

# instances_dir is a git repository = the operator-facing change log of the instance
# records (Store commits every create/patch/rm). Everything runs AS lmnradius, the owner
# of the directory (chown above) and the user the service commits as: up to 7.3.0 the
# repo was initialised and configured as root AFTER the chown, git refused the
# root-owned-vs-lmnradius-owned mix ("dubious ownership" -> "fatal: not in a git
# directory"), the identity was never set and every commit died with "empty ident
# name" -- the change log stayed empty (found on real installs, 2026-09-22).
# Idempotent: repairs an existing 7.3.0 repo (identity, pending records) on upgrade.
# Background maintenance is off in the repository config, set before its first commit: git
# 2.47 and later start auto-maintenance after a commit as a DETACHED process that creates
# and removes files under .git (objects/maintenance.lock) while the `chown -R` above walks
# the tree on the next configure; linuxmuster-squid 7.3.1-7.3.3 failed its configure on
# exactly that race. The service's own commits read the same repository config, so they
# spawn none either. A change log of a few commits needs no gc.
INST_DIR=/var/lib/linuxmuster-radius/instances
if command -v git >/dev/null 2>&1; then
    # runuser resets HOME, not XDG_CONFIG_HOME: an admin environment pointing it into /root
    # (GitHub runners, `sudo -E`) would make every git call warn "unable to access
    # '/root/.config/git/...': Permission denied".
    as_lmnradius() { runuser -u lmnradius -- env -u XDG_CONFIG_HOME "$@"; }
    if [ ! -d "$INST_DIR/.git" ]; then
        as_lmnradius git -C "$INST_DIR" -c init.defaultBranch=main init -q
    fi
    as_lmnradius git -C "$INST_DIR" config user.name  "linuxmuster-radius"
    as_lmnradius git -C "$INST_DIR" config user.email "lmnradius@localhost"
    as_lmnradius git -C "$INST_DIR" config maintenance.auto false
    as_lmnradius git -C "$INST_DIR" config gc.auto 0
    # Records written while the change log was broken (staged but never committed, or
    # never added) become one import commit, so `git log` is complete after the upgrade.
    for f in "$INST_DIR"/*.yaml; do
        [ -e "$f" ] && as_lmnradius git -C "$INST_DIR" add -- "$(basename "$f")"
    done
    if ! as_lmnradius git -C "$INST_DIR" diff --cached --quiet; then
        as_lmnradius git -C "$INST_DIR" commit -q -m "lmnradius: import existing instance records (package configure)"
    fi
fi

# Harden the shipped tree on EVERY configure, not only on upgrade: 0.1.6 and earlier
# shipped /opt/linuxmuster-radius world-writable (0777 directories, 0666 files). dpkg
# resets the mode of every file it replaces but leaves EXISTING directories untouched, so
# a server upgraded from 0.1.6 keeps world-writable directories -- among them
# venv/lib/python3.12/site-packages, where a dropped .pth file runs as lmnradius, and
# lmnradius is in the docker group. Only the write bits are cleared (`go-w`, never a
# blanket 0755), so anything intentionally restrictive stays as restrictive as it was.
chmod -R go-w /opt/linuxmuster-radius

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
    systemctl enable linuxmuster-radius.service || true
    # Load new code on a genuine upgrade (try-restart no-ops if the service is not
    # running), then start unconditionally so it is up in ALL cases -- fresh install
    # AND reinstall over a removed/config-files state, where try-restart alone would
    # leave it stopped. `start` is a no-op if it is already running.
    if [ -n "${2:-}" ]; then
        systemctl try-restart linuxmuster-radius.service || true
    fi
    systemctl start linuxmuster-radius.service || true
    # On upgrade, lift all running instances onto this package's pinned default
    # image (best-effort; each instance updates with its own health-check
    # auto-rollback). Wait briefly for the restarted API; never fail the install.
    if [ -n "${2:-}" ]; then
        LMN=/opt/linuxmuster-radius/venv/bin/lmnradius
        i=0
        while [ "$i" -lt 30 ]; do
            "$LMN" health >/dev/null 2>&1 && break
            i=$((i + 1)); sleep 1
        done
        "$LMN" update-all >/dev/null 2>&1 || true
    fi
fi

#DEBHELPER#
exit 0
