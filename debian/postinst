#!/bin/sh
# SPDX-FileCopyrightText: Kevin Stenzel
# SPDX-License-Identifier: GPL-3.0-or-later
set -e

# System user (in the docker group for socket access)
if ! getent passwd lmnradius >/dev/null 2>&1; then
    adduser --system --group --no-create-home \
        --home /var/lib/linuxmuster-radius lmnradius
fi
if getent group docker >/dev/null 2>&1; then
    usermod -aG docker lmnradius || true
fi

# Config + secrets + EAP certs live under /etc; instances (git log) + rendered
# instance.d configs live under /var/lib. Keys below MUST match lmnradius.config.Settings.
mkdir -p /etc/linuxmuster-radius/secrets /etc/linuxmuster-radius/certs \
         /var/lib/linuxmuster-radius/instances /var/lib/linuxmuster-radius/instance.d

# Config with a random API token (only if it does not exist yet)
CFG=/etc/linuxmuster-radius/config.yml
if [ ! -f "$CFG" ]; then
    TOKEN="$(openssl rand -hex 32)"
    # umask 077 -> file is created with 0600 (no 0644 window for the API token).
    ( umask 077
      cat > "$CFG" <<EOF
api_token: "$TOKEN"
instances_dir: /var/lib/linuxmuster-radius/instances
secrets_dir: /etc/linuxmuster-radius/secrets
certs_dir: /etc/linuxmuster-radius/certs
render_dir: /var/lib/linuxmuster-radius/instance.d
bind_host: 127.0.0.1
bind_port: 8080
api_url: http://127.0.0.1:8080
EOF
    )
    chmod 600 "$CFG"
fi

chown -R lmnradius:lmnradius /etc/linuxmuster-radius /var/lib/linuxmuster-radius
# secrets holds per-client shared secrets; certs holds EAP CA + server keys.
chmod 700 /etc/linuxmuster-radius/secrets /etc/linuxmuster-radius/certs

# instances_dir is a git repository = the operator-facing change log of the instance
# records (Store commits every create/patch/rm). Everything runs AS lmnradius, the owner
# of the directory (chown above) and the user the service commits as: up to 7.3.0 the
# repo was initialised and configured as root AFTER the chown, git refused the
# root-owned-vs-lmnradius-owned mix ("dubious ownership" -> "fatal: not in a git
# directory"), the identity was never set and every commit died with "empty ident
# name" -- the change log stayed empty (found on real installs, 2026-09-22).
# Idempotent: repairs an existing 7.3.0 repo (identity, pending records) on upgrade.
# Background maintenance is off in the repository config, set before its first commit: git
# 2.47 and later start auto-maintenance after a commit as a DETACHED process that creates
# and removes files under .git (objects/maintenance.lock) while the `chown -R` above walks
# the tree on the next configure; linuxmuster-squid 7.3.1-7.3.3 failed its configure on
# exactly that race. The service's own commits read the same repository config, so they
# spawn none either. A change log of a few commits needs no gc.
# A failing git step never stops the configure and never passes silently: the service and the
# instance records do not depend on the change log (up to 7.3.4 `set -e` aborted the whole
# configure on it). Each failure prints one WARNING line on stderr with the step and the
# repository, below git's own message; the configure and the service handling below go on as
# without it. Until the repository is repaired (docs/operations.md), the service records
# instance changes unversioned or refuses them with git's message (Store).
INST_DIR=/var/lib/linuxmuster-radius/instances
if command -v git >/dev/null 2>&1; then
    # runuser resets HOME, not XDG_CONFIG_HOME: an admin environment pointing it into /root
    # (GitHub runners, `sudo -E`) would make every git call warn "unable to access
    # '/root/.config/git/...': Permission denied".
    as_lmnradius() { runuser -u lmnradius -- env -u XDG_CONFIG_HOME "$@"; }
    log_git() { as_lmnradius git -C "$INST_DIR" "$@"; }
    log_warn() {
        echo "linuxmuster-radius: WARNING: instance change log $INST_DIR: '$1' failed;" \
            "configuring goes on; repair the repository (docs/operations.md), until then" \
            "instance changes are not versioned or are refused" >&2 || :
    }
    log_ok=1
    if [ ! -d "$INST_DIR/.git" ]; then
        log_git -c init.defaultBranch=main init -q || { log_warn "git init"; log_ok=; }
    elif ! log_git rev-parse --git-dir >/dev/null; then
        log_warn "git rev-parse (the repository is unusable, the other change-log steps are skipped)"
        log_ok=
    fi
    if [ -n "$log_ok" ]; then
        log_git config user.name "linuxmuster-radius" || log_warn "git config user.name"
        log_git config user.email "lmnradius@localhost" || log_warn "git config user.email"
        log_git config maintenance.auto false || log_warn "git config maintenance.auto false"
        log_git config gc.auto 0 || log_warn "git config gc.auto 0"
        # Records written while the change log was broken (staged but never committed, or
        # never added) become one import commit, so `git log` is complete after the upgrade.
        for f in "$INST_DIR"/*.yaml; do
            [ -e "$f" ] || continue
            f="$(basename "$f")"
            log_git add -- "$f" || log_warn "git add $f"
        done
        # 0: nothing staged, 1: records to commit, anything else: git could not compare.
        if log_git diff --cached --quiet; then log_rc=0; else log_rc=$?; fi
        if [ "$log_rc" = 1 ]; then
            log_git commit -q -m "lmnradius: import existing instance records (package configure)" \
                || log_warn "git commit (import of existing instance records)"
        elif [ "$log_rc" != 0 ]; then
            log_warn "git diff --cached"
        fi
    fi
fi

# Harden the shipped tree on EVERY configure, not only on upgrade: 0.1.6 and earlier
# shipped /opt/linuxmuster-radius world-writable (0777 directories, 0666 files). dpkg
# resets the mode of every file it replaces but leaves EXISTING directories untouched, so
# a server upgraded from 0.1.6 keeps world-writable directories -- among them
# venv/lib/python3.12/site-packages, where a dropped .pth file runs as lmnradius, and
# lmnradius is in the docker group. Only the write bits are cleared (`go-w`, never a
# blanket 0755), so anything intentionally restrictive stays as restrictive as it was.
chmod -R go-w /opt/linuxmuster-radius

# The service by Debian's rules, as dh_installsystemd's snippets do it, by hand because the
# unit stays in /lib/systemd/system (moving it to /usr/lib within one package risks losing it
# under usrmerge). deb-systemd-helper keeps the admin's decision: a new installation enables
# the service, afterwards it stays as the admin left it, so `systemctl disable` survives
# upgrades (up to 7.3.5 every configure enabled it again). The preinst recorded the state of a
# server coming from 7.3.5 or older. Without a running systemd (image build, chroot) only the
# links are made and the service starts with the next boot.
UNIT=linuxmuster-radius.service
# unmask as dh_installsystemd still does: it lifts only a mask deb-systemd-helper set itself
# (older debhelper masked on remove), never one of the admin.
deb-systemd-helper unmask "$UNIT" >/dev/null || true
if deb-systemd-helper --quiet was-enabled "$UNIT"; then
    deb-systemd-helper enable "$UNIT" >/dev/null || true
else
    deb-systemd-helper update-state "$UNIT" >/dev/null || true
fi

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
    # Enabled: restart on an upgrade (loads the new code, starts a stopped service), start on
    # a new installation. Disabled or masked: only try-restart, so a service that still runs
    # gets the new code and a stopped one stays stopped (restart would do the same for a
    # disabled unit but print "not starting it", and it fails on a masked unit that runs).
    # deb-systemd-invoke honours policy-rc.d.
    if [ "$(systemctl is-enabled "$UNIT" 2>/dev/null)" = enabled ]; then
        if [ -n "${2:-}" ]; then
            deb-systemd-invoke restart "$UNIT" || true
        else
            deb-systemd-invoke start "$UNIT" || true
        fi
    else
        deb-systemd-invoke try-restart "$UNIT" || true
    fi
    # On upgrade, lift all instances onto this package's pinned default image (best-effort;
    # each instance updates with its own health-check auto-rollback), but only through a
    # service that runs after this configure; a service the admin keeps off is not started
    # for it. Wait briefly for the restarted API; never fail the install.
    if [ -n "${2:-}" ] && ! systemctl is-active --quiet "$UNIT"; then
        echo "linuxmuster-radius: the service is $(systemctl is-enabled "$UNIT" 2>/dev/null)" \
             "and not running, instances not updated; run 'lmnradius update-all' after starting it"
    elif [ -n "${2:-}" ]; then
        LMN=/opt/linuxmuster-radius/venv/bin/lmnradius
        i=0
        while [ "$i" -lt 30 ]; do
            "$LMN" health >/dev/null 2>&1 && break
            i=$((i + 1)); sleep 1
        done
        "$LMN" update-all >/dev/null 2>&1 || true
    fi
fi

#DEBHELPER#
exit 0
