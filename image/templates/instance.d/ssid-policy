#
# linuxmuster-radius -- per-SSID group gate + optional dynamic VLAN.
#
# INCLUDED INTO: sites/inner-tunnel -> post-auth, via '$-INCLUDE'.
# GENERATED BY:  the P2 control plane, from the instance's ssids[]. THIS shipped
#                file is the SAFE DEFAULT so 'radiusd -XC' passes before/without
#                that render; a read-only mount at
#                ${confdir}/instance.d/ssid-policy overrides it.
#
# CONTEXT available here (PEAP inner tunnel -- the real identity is known):
#   &Called-Station-SSID    the SSID, from rewrite_called_station_id, copied in
#                           by copy_request_to_tunnel = yes.
#   &LDAP-Group == "<cn>"   a live AD group-membership check (rlm_ldap).
#   update reply { Tunnel-* }  optional RADIUS-assigned VLAN (RFC 3580). With
#                           use_tunneled_reply = yes it lands on the OUTER
#                           Access-Accept. Value names come from the stock
#                           dictionaries: Tunnel-Type VLAN = 13,
#                           Tunnel-Medium-Type IEEE-802 = 6.
#
# DEFAULT POSTURE (this file): do nothing. The BASE 'wifi' gate (ntlm_auth
# --require-membership-of, mods/mschap) still applies, and VLANs fall back to
# the STATIC per-SSID VLAN configured in UniFi. Intentionally permissive so a
# missing or late-rendered policy never locks everyone out of Wi-Fi.
#
# ---- EXAMPLE of what the control plane emits (illustrative; do not rely on) ----
#  if (&Called-Station-SSID == "school-lehrer") {
#      if (&LDAP-Group == "school-teachers") {
#          update reply {
#              &Tunnel-Type := VLAN
#              &Tunnel-Medium-Type := IEEE-802
#              &Tunnel-Private-Group-Id := "20"
#          }
#      }
#      else {
#          reject          # right SSID, wrong role -> deny
#      }
#  }
#  elsif (&Called-Station-SSID == "school-schueler") {
#      if (&LDAP-Group == "school-students") {
#          update reply {
#              &Tunnel-Type := VLAN
#              &Tunnel-Medium-Type := IEEE-802
#              &Tunnel-Private-Group-Id := "30"
#          }
#      }
#      else {
#          reject
#      }
#  }
#  else {
#      reject              # unknown SSID on this instance -> deny
#  }
# -------------------------------------------------------------------------------

#  Safe default: match nothing, change nothing (see DEFAULT POSTURE above).
noop
