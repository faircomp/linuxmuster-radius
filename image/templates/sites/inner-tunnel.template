#
# linuxmuster-radius -- INNER virtual server (sites-enabled/inner-tunnel).
#
# HOW IT WIRES: mods/eap -> peap { virtual_server = "inner-tunnel" } hands the
# PEAP inner EAP-MSCHAPv2 exchange to this server. Here the REAL user identity
# and AD groups are known (unlike the anonymous outer request), so BOTH gates
# live here:
#   * BASE 'wifi' gate   -> mods/mschap: ntlm_auth --require-membership-of
#                           (winbind has the DC validate the NT-hash + wifi
#                           membership);
#   * per-SSID ROLE gate + optional VLAN -> post-auth, via rlm_ldap.
#
# Auth path:  eap (inner EAP-MSCHAPv2) -> mschap -> ntlm_auth -> winbind -> DC.
# ldap (authorize) locates the user object so the post-auth
# '&LDAP-Group == "<cn>"' comparisons resolve.
#
# Uniform envsubst render pipeline; this file substitutes NO instance variables
# -- the per-SSID data is the mounted instance.d/ssid-policy (data, not baked
# config). FreeRADIUS ${confdir}/%{...} tokens pass through unchanged.
#
server inner-tunnel {
	authorize {
		filter_username

		#  &Called-Station-SSID arrives here from the outer request
		#  (copy_request_to_tunnel = yes), ready for the post-auth SSID gate.

		#  Sets Auth-Type for a direct MSCHAP inner exchange, if any.
		chap
		mschap

		#  Inner EAP-MSCHAPv2.
		eap {
			ok = return
		}

		#  Locate the user in AD (sAMAccountName) so &LDAP-Group works later.
		#  '-ldap' = optional: a transient LDAP hiccup must not 500 the request
		#  before winbind even runs; the post-auth gate re-checks membership.
		-ldap

		pap
	}

	authenticate {
		Auth-Type MS-CHAP {
			mschap
		}
		mschap

		#  EAP-MSCHAPv2: internally calls the mschap module (-> ntlm_auth).
		eap
	}

	session {
	}

	post-auth {
		#  ===============================================================
		#  PER-SSID GROUP GATE + optional dynamic VLAN.
		#
		#  The concrete SSID -> allowed-group -> VLAN table is DATA, generated by
		#  the P2 control plane from the instance's ssids[] and mounted read-only
		#  at ${confdir}/instance.d/ssid-policy. '$-INCLUDE' is an OPTIONAL
		#  include, so 'radiusd -XC' stays green even if that file is absent (the
		#  image ships a safe default at the same path; a mount overrides it).
		#
		#  The included unlang branches on &Called-Station-SSID and, per SSID:
		#    if (&LDAP-Group == "<school>-teachers") { set Tunnel-* } else { reject }
		#  With use_tunneled_reply = yes (mods/eap) any Tunnel-* set here
		#  propagate onto the OUTER Access-Accept. See instance.d/ssid-policy.
		#  ===============================================================
		$-INCLUDE ${confdir}/instance.d/ssid-policy

		#  Access-Reject post-processing. Surface which inner module failed so
		#  the outer session can log a useful reason.
		Post-Auth-Type REJECT {
			attr_filter.access_reject

			update outer.session-state {
				&Module-Failure-Message := &request:Module-Failure-Message
			}
		}
	}
}
